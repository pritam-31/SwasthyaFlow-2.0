# SwasthyaFlow AI triage service configuration.
# All values have safe defaults; nothing here is required to boot.

# Server
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=info

# Storage
AI_MODELS_DIR=./models
AI_DATA_DIR=./data
AI_DB_PATH=./data/predictions.sqlite3
# Salt used to pseudonymise patient identifiers before logging (HIPAA/GDPR).
# CHANGE THIS IN PRODUCTION.
AI_PII_SALT=change-me-in-production

# NLP. When transformers is installed the service tries this model first.
# A multilingual NLI/classification checkpoint gives the best Hindi + English
# coverage. Without transformers, the deterministic bilingual lexicon is used.
AI_NLP_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
AI_NLP_DEVICE=cpu
AI_NLP_MAX_LENGTH=256

# Optional bearer token. If set, every /predict-severity and /override request
# must send "Authorization: Bearer <token>". Recommended for any non-localhost
# deployment so the AI service is not publicly reachable.
AI_SERVICE_TOKEN=

# CORS origins allowed to call the service directly (comma separated).
AI_CORS_ORIGINS=

# Behaviour
AI_ENABLE_FEEDBACK=true
AI_AUTO_RETRAIN_ON_OVERRIDE=false

{
  "name": "swasthyaflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API stub for the human-in-the-loop triage assistant (non-diagnostic).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test --import ./test/setup-env.ts test/reports.test.ts test/visuals.test.ts test/multilingual.test.ts test/timeline.test.ts test/followups.test.ts test/retention.test.ts test/anonymisation.test.ts test/sync.test.ts test/facilities.test.ts test/priority.test.ts test/security.test.ts test/modelcard.test.ts test/bias.test.ts test/confidence.test.ts test/feedback.test.ts test/auditChain.test.ts test/consent.test.ts test/retentionUi.test.ts test/richCoverage.test.ts test/appointments.test.ts",
    "test:db": "tsx --test test/db/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "eval:generate": "tsx src/eval/cli/generate.ts",
    "eval:run": "tsx src/eval/cli/run.ts",
    "eval:leak": "tsx src/eval/cli/leak.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:indexes": "tsx scripts/setup-indexes.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:migrate-memory": "tsx scripts/migrate-from-memory.ts",
    "db:migrate-facility": "tsx scripts/migrate-facility-scope.ts",
    "db:backfill-audit-chain": "tsx scripts/backfill-audit-chain.ts",
    "db:seed-sla": "tsx scripts/seed-sla-config.ts",
    "db:seed-security": "tsx scripts/seed-security-policy.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

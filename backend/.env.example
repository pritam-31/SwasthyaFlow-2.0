# Copy to backend/.env and fill in local/Atlas values. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Atlas URI placeholder only; replace locally with your own connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/swasthyaflow?retryWrites=true&w=majority
MONGODB_DB_NAME=swasthyaflow
SEED_ON_BOOT=false

# Required for production image/report storage.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Set to the exact browser origin(s) that call this API.
CORS_ORIGIN=http://localhost:5173,https://swasthya-flow-2-0.vercel.app
# Auth cookies are always host-only; no cookie domain setting is needed.
# Production defaults to SameSite=None; Secure. Use HTTPS for production.

TRUST_PROXY=false
ENABLE_BODY_TOKEN=false

# Generate unique random values for deployed environments; never use these
# placeholder labels as actual secrets.
SESSION_SECRET_V1=replace-with-a-random-secret
REFRESH_SECRET_V1=replace-with-a-random-secret
CSRF_SECRET_V1=replace-with-a-random-secret
TWO_FACTOR_ENC_KEY_V1=replace-with-a-32-byte-key

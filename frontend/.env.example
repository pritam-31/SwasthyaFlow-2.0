# SwasthyaFlow AI — frontend environment
# Copy to .env.local and fill in. Never commit .env.local.

# MUI X Pro licence key (required to remove the watermark from @mui/x-data-grid-pro).
# Leave blank / omit to run in evaluation mode during development.
VITE_MUI_X_LICENSE_KEY=

# Optional local-development backend override. 
# In production, set this to your backend URL (e.g. https://swasthyaflow-20-production.up.railway.app)
# so the frontend knows where to send API requests. If empty, relative /api paths are used
# (only works when frontend and backend share the same origin).
VITE_API_BASE_URL=https://swasthyaflow-20-production.up.railway.app

# MongoDB connection string (backend use only). 
# Used by the database connector to persist app data.
MONGODB_URI=mongodb+srv://techptm31_db_user:fn1ZZYHyKTb0Ngz8@cluster0.rhppusv.mongodb.net/swasthyaflow?appName=Cluster0

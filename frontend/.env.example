# SwasthyaFlow frontend environment
# Copy to .env.local and fill in. Never commit .env.local.

# MUI X Pro licence key (optional during evaluation).
VITE_MUI_X_LICENSE_KEY=

# Optional local-development backend override only.
# Production always uses the same-origin /api proxy for cookie authentication.
VITE_API_BASE_URL=

# Set to "true" to hide the "Demo accounts — tap to fill" panel on the login page.
# Leave unset to show it (default; handy for prototype/demo deployments).
VITE_HIDE_DEMO_ACCOUNTS=

# --- Production web server (server.mjs) ---
# Backend the SPA proxies /api and /health to. Prefer Railway private networking
# when both services live in the same project, otherwise use the public URL.
# BACKEND_URL=http://<backend-service>.railway.internal:4000
# BACKEND_URL=https://swasthyaflow-20-production.up.railway.app

# MongoDB credentials belong in backend configuration, never frontend variables.
